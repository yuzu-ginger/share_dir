            {
              "id": "CA5403",
              "shortDescription": {
                "text": "証明書をハードコーディングしない"
              },
              "fullDescription": {
                "text": "ソース コード内のハードコーディングされた証明書は、悪用される可能性があります。"
              },
              "defaultConfiguration": {
                "enabled": false
              },
              "helpUri": "https://learn.microsoft.com/dotnet/fundamentals/code-analysis/quality-rules/ca5403",
              "properties": {
                "category": "Security",
