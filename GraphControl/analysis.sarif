                ]
              }
            },
            {
              "id": "CA5402",
              "shortDescription": {
                "text": "既定の IV で CreateEncryptor を使用する"
              },
              "fullDescription": {
                "text": "対称暗号化では、辞書攻撃を防ぐために、反復不能な初期化ベクトルを常に使用する必要があります。"
              },
              "defaultConfiguration": {
                "enabled": false
              },
              "helpUri": "https://learn.microsoft.com/dotnet/fundamentals/code-analysis/quality-rules/ca5402",
