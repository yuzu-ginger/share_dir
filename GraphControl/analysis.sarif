                  "Telemetry",
                  "EnabledRuleInAggressiveMode"
                ]
              }
            },
            {
              "id": "CA5405",
              "shortDescription": {
                "text": "委任のトークンの検証を常にスキップしない"
              },
              "fullDescription": {
                "text": "重要な TokenValidationParameter 検証委任を TRUE に設定すると、重要な認証の保護が無効になるため、発行元のトークンや有効期限が切れたトークンが誤って検証される可能性があります。"
              },
              "defaultConfiguration": {
                "enabled": false
              },
              "helpUri": "https://learn.microsoft.com/dotnet/fundamentals/code-analysis/quality-rules/ca5405",
              "properties": {
                "category": "Security",
                "isEverSuppressed": "true",
