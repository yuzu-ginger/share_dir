              }
            },
            {
              "id": "CA1019",
              "shortDescription": {
                "text": "属性引数にアクセサーを定義します"
              },
              "defaultConfiguration": {
                "enabled": false
              },
              "helpUri": "https://learn.microsoft.com/dotnet/fundamentals/code-analysis/quality-rules/ca1019",
