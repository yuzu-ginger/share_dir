            {
              "id": "SYSLIB1045",
              "shortDescription": {
                "text": "'GeneratedRegexAttribute' に変換します。"
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "helpUri": "https://learn.microsoft.com/dotnet/fundamentals/syslib-diagnostics/syslib1045",
              "properties": {
                "category": "Performance",
                "executionTimeInSeconds": "<0.001",
